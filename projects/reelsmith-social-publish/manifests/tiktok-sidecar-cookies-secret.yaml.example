# NOT applied via ArgoCD. Template only.
#
# The real `tiktok-sidecar-cookies` Secret is created out-of-band by the
# operator after running the interactive login on Mac:
#
#   scp CookiesDir/tiktok_session-reelsmith.cookie homelab:/tmp/
#   ssh homelab "microk8s kubectl -n n8n-live create secret generic \
#     tiktok-sidecar-cookies \
#     --from-file=tiktok_session-reelsmith.cookie=/tmp/tiktok_session-reelsmith.cookie \
#     --dry-run=client -o yaml | microk8s kubectl apply -f -"
#   ssh homelab "rm /tmp/tiktok_session-reelsmith.cookie"
#   ssh homelab "microk8s kubectl -n n8n-live rollout restart deploy/tiktok-sidecar"
#
# Cookies expire every 2-4 weeks. Refresh monthly OR when sidecar logs show
# 401/403 errors. Refresh procedure is the same as initial bootstrap.
#
# CRITICAL: never `kubectl delete pod` for cookie refresh. ArgoCD selfHeal
# will recreate the pod before initContainer re-runs. Always `rollout restart`.
---
apiVersion: v1
kind: Secret
metadata:
  name: tiktok-sidecar-cookies
  namespace: n8n-live
  labels:
    app.kubernetes.io/name: tiktok-sidecar
    app.kubernetes.io/part-of: reelsmith-social-publish
type: Opaque
data:
  # Real cookies are base64-encoded by kubectl when using --from-file.
  # Filename pattern: tiktok_session-<account>.cookie (NOT <account>.cookie).
  # File contents come from the makiisthenes uploader's login flow.
  tiktok_session-reelsmith.cookie: <base64-encoded-cookie-blob-from-Mac>
