# NOT applied via ArgoCD (the .example extension keeps it out). Template only.
#
# The real `tiktok-sidecar-cookies` Secret is created and refreshed out-of-band
# by `make refresh-cookies` in the tiktok-sidecar repo: you log in, the script
# checks the cookie, replaces the Secret over `ssh` stdin with
# `kubectl create --dry-run=client -o yaml | kubectl replace -f -` (no copy on
# the host's disk, no last-applied annotation holding a second copy), then
# restarts the sidecar and probes /healthz/session.
#
# Cookies expire every few weeks. Refresh when n8n or the watchdog alerts
# "cookie expired - run make refresh-cookies".
---
apiVersion: v1
kind: Secret
metadata:
  name: tiktok-sidecar-cookies
  namespace: n8n-live
  labels:
    app.kubernetes.io/name: tiktok-sidecar
    app.kubernetes.io/part-of: reelsmith-social-publish
type: Opaque
data:
  # Real cookies are base64-encoded by kubectl when using --from-file.
  # Filename pattern: tiktok_session-<account>.cookie (NOT <account>.cookie).
  # File contents come from the makiisthenes uploader's login flow.
  tiktok_session-reelsmith.cookie: <base64-encoded-cookie-blob-from-Mac>
